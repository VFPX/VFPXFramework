DEFINE CLASS vfpxstatusbar AS vfpxbasecontainer OF "vfpxbaselibrary.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="linSeparator" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblStatus" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblMessage" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: updatemessage		&& Updates the message
		*m: updatestatus		&& Updates the status label
	*</DefinedPropArrayMethod>

	*<PropValue>
		Anchor = 0
		Height = 20
		Name = "vfpxstatusbar"
		Width = 450
		_memberdata = <VFPData>
			<memberdata name="updatestatus" display="UpdateStatus"/>
			<memberdata name="updatemessage" display="UpdateMessage"/>
		</VFPData>
	*</PropValue>

	ADD OBJECT 'lblMessage' AS vfpxbaselabel WITH ;
		Caption = "Message'", ;
		Left = 6, ;
		Name = "lblMessage", ;
		Top = 3
		*< END OBJECT: ClassLib="vfpxbaselibrary.vcx" BaseClass="label" />

	ADD OBJECT 'lblStatus' AS vfpxbaselabel WITH ;
		Alignment = 1, ;
		Anchor = 8, ;
		Caption = "Status", ;
		Left = 410, ;
		Name = "lblStatus", ;
		Top = 3
		*< END OBJECT: ClassLib="vfpxbaselibrary.vcx" BaseClass="label" />

	ADD OBJECT 'linSeparator' AS vfpxbaseline WITH ;
		Anchor = 10, ;
		Height = 0, ;
		Left = 0, ;
		Name = "linSeparator", ;
		Top = 0, ;
		Width = 450
		*< END OBJECT: ClassLib="vfpxbaselibrary.vcx" BaseClass="line" />
	
	PROCEDURE Init
		This.Anchor = 0
		This.Width  = Thisform.Width
		This.Top    = Thisform.Height - This.Height
		This.linSeparator.Width = This.Width
		This.lblStatus.Left = This.Width - This.lblStatus.Width - 6
		This.Anchor = 14
		
	ENDPROC

	PROCEDURE updatemessage		&& Updates the message
		* Update the message.
		
		lparameters tcMessage
		This.lblMessage.Caption = evl(tcMessage, '')
		keyboard ' '
		inkey()
		doevents
		inkey(0.001, 'H')
		
	ENDPROC

	PROCEDURE updatestatus		&& Updates the status label
		* Update the status.
		
		lparameters tcStatus
		This.lblStatus.Caption = evl(tcStatus, '')
		keyboard ' '
		inkey()
		doevents
		inkey(0.001, 'H')
		
	ENDPROC

	PROCEDURE lblMessage.Init
		This.Caption = ''
		
	ENDPROC

	PROCEDURE lblStatus.Init
		This.Caption = ''
		
	ENDPROC

ENDDEFINE
